              "content": [
                {
                  "type": "text",
                  "text": "QUIZ 16 · ID: second-harness",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Quando um segundo harness se justifica?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A. Sempre que a tarefa tiver mais de duas etapas"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "B. Fornecedores diferentes ou frentes longas e independentes"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "C. Quando a janela de contexto do primeiro enche"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "GABARITO: B — Fornecedores diferentes ou frentes longas e independentes"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "POR QUÊ (EXPLICAÇÃO DO JOGO)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Outro harness duplica contexto e coordenação. Comece com a composição mais"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "simples que atende a tarefa."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
