            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Ensine as cinco partes do formato usado: título, status, contexto,"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "decisão e consequências. O ADR costuma ser curto e fica versionado"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "junto do código."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "NA FALA / DEMONSTRAÇÃO"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Use o exemplo do worker dedicado: necessidade → escolha →"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "consequências de limites e deploy separados."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
