                  "text": "Para que serve o campo description de um subagente?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A. Dizer em que situação a delegação faz sentido"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "B. Virar o system prompt do subagente"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "C. Definir quais ferramentas ele pode usar"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "GABARITO: A — Dizer em que situação a delegação faz sentido"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "POR QUÊ (EXPLICAÇÃO DO JOGO)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "name e description são obrigatórios. O corpo do markdown é que vira o system"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "prompt; tools define o conjunto permitido."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
