                  "text": "01 · Contexto, harness e panorama",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Preparação do apresentador · 4 perguntas · respostas extraídas do banco do jogo"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Leia de cima para baixo: ensine o conceito à esquerda e confira a cobrança à direita."
                }
