              "content": [
                {
                  "type": "text",
                  "text": "ENSINAR 20 · Worktree",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Apoio: slide(s) 10 + 15; reforço explícito"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Diga literalmente: worktree isola diretório e branch; não é"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "sandbox de permissões nem mecanismo de coordenação. Coordenação"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "fica com o harness/orquestrador; permissões precisam de política"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "própria."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "NA FALA / DEMONSTRAÇÃO"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Ponte que deve entrar na fala: duas frentes podem editar arquivos"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "separados e ainda afetar o mesmo servidor de produção."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
    {
      "x": 960,
