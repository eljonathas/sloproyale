        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "ENSINAR 31 · Case",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Apoio: slide(s) 24"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Explique a cadeia causal: worker configurado para I/O → modelo"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "pesado em vários processos → consumo sem limites → saturação da"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "VPS → indisponibilidade do site."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "NA FALA / DEMONSTRAÇÃO"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Dados do case: 4 vCPU compartilhados, pico observado de 15 GB no"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "container e cerca de 20 minutos fora do ar. Não foi exclusão do"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "banco nem bloqueio da Steam."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
    {
      "x": 960,
      "y": 1588,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {
