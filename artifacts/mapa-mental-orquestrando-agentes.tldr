        "questionId": "worktree-add",
        "role": "quiz",
        "answer": 2
      },
      "id": "shape:n69",
      "type": "geo",
      "parentId": "page:p4",
      "index": "b07F8b",
      "props": {
        "geo": "rectangle",
        "dash": "solid",
        "url": "",
        "w": 980,
        "h": 396,
        "growY": 0,
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "labelColor": "black",
        "color": "green",
        "fill": "fill",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "QUIZ 18 · ID: worktree-add",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Qual comando abre outra worktree numa branch nova?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A. git clone --branch feature/api ../api"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "B. git worktree list --new feature/api"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "C. git worktree add ../api -b feature/api"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "GABARITO: C — git worktree add ../api -b feature/api"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "POR QUÊ (EXPLICAÇÃO DO JOGO)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "git worktree list mostra o mapa dos checkouts e git worktree remove desfaz, sem"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "criar outro histórico nem outro remote."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
