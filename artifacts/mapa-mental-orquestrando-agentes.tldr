        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "ENSINAR 16 · Orquestração",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Apoio: slide(s) 12"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Um segundo harness pode fazer sentido para fornecedores"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "diferentes, frentes longas e independentes, comparação de"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "abordagens ou limitação operacional. Ele acrescenta coordenação e"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "contexto."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "NA FALA / DEMONSTRAÇÃO"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Contraponha ao distrator: ter mais de duas etapas ou encher a"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "janela de contexto, por si só, não justifica a mudança."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
    {
      "x": 960,
      "y": 2054,
      "rotation": 0,
