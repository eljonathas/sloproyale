              "content": [
                {
                  "type": "text",
                  "text": "ENSINAR 35 · Autonomia",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Apoio: slide(s) 28"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Liste o que virou regra: limites de CPU e memória em produção;"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "aprovação para deploy compartilhado; ADR para decisão estrutural;"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "ferramentas conforme a função."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "NA FALA / DEMONSTRAÇÃO"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Diferencie aprovação humana de execução exclusivamente manual. O"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "agente pode executar uma ação aprovada dentro da política."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
    {
      "x": 960,
      "y": 1122,
      "rotation": 0,
