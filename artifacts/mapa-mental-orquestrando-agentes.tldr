      },
      "id": "shape:n18",
      "type": "geo",
      "parentId": "page:p1",
      "index": "aILhz",
      "props": {
        "geo": "rectangle",
        "dash": "solid",
        "url": "",
        "w": 980,
        "h": 396,
        "growY": 0,
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "labelColor": "black",
        "color": "green",
        "fill": "fill",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "QUIZ 02 · ID: harness",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "O que o harness faz, além de chamar o modelo?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A. Treina o modelo com os arquivos do repositório"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "B. Monta contexto, roda ferramentas, aplica sandbox e estado"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "C. Troca de fornecedor quando o modelo erra"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "GABARITO: B — Monta contexto, roda ferramentas, aplica sandbox e estado"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "POR QUÊ (EXPLICAÇÃO DO JOGO)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "O harness é a camada que faz o modelo trabalhar: contexto, modelo, ferramentas,"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "sandbox e aprovação, estado entre turnos."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
