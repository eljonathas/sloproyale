            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Por onde começar num repositório novo?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A. Pelo segundo harness, para comparar abordagens"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "B. Pela automação do deploy em produção"
                }
