        "answer": 1
      },
      "id": "shape:n117",
      "type": "geo",
      "parentId": "page:p7",
      "index": "b0trz3",
      "props": {
        "geo": "rectangle",
        "dash": "solid",
        "url": "",
        "w": 980,
        "h": 396,
        "growY": 0,
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "labelColor": "black",
        "color": "green",
        "fill": "fill",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "QUIZ 33 · ID: tipos-de-risco",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Editar código e operar um ambiente pedem o quê do harness?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A. O mesmo tratamento, já que os dois alteram arquivos"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "B. Políticas diferentes de execução e aprovação"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "C. Aprovação humana nos dois casos, sempre"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "GABARITO: B — Políticas diferentes de execução e aprovação"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "POR QUÊ (EXPLICAÇÃO DO JOGO)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Deploy, migration, consumo de recursos compartilhados e mudança de permissões"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "têm blast radius próprio e pedem política própria."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
