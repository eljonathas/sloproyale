      },
      "id": "shape:n120",
      "type": "geo",
      "parentId": "page:p7",
      "index": "b0wjTI",
      "props": {
        "geo": "rectangle",
        "dash": "solid",
        "url": "",
        "w": 980,
        "h": 396,
        "growY": 0,
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "labelColor": "black",
        "color": "green",
        "fill": "fill",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "QUIZ 34 · ID: autonomy",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Por reversibilidade e blast radius, o que exige aprovação?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A. Qualquer mudança de código acima de 100 linhas"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "B. Produção: dados, permissões e recursos compartilhados"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "C. Toda execução de teste que use rede"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "GABARITO: B — Produção: dados, permissões e recursos compartilhados"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "POR QUÊ (EXPLICAÇÃO DO JOGO)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Local e efêmero admite autonomia alta; staging compartilhado pede regras e"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "revisão seletiva; produção fica atrás de aprovação humana."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
