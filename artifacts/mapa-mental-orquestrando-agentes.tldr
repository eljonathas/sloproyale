                {
                  "type": "text",
                  "text": "04 · Worktrees na prática",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Preparação do apresentador · 4 perguntas · respostas extraídas do banco do jogo"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
