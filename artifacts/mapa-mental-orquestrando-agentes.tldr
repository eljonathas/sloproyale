            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Que custo o paralelismo acrescenta além da fatura do modelo?"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A. Tempo de convergir e risco em ambiente compartilhado"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "B. Licenças adicionais por subagente aberto"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "C. Armazenamento: cada worktree duplica o histórico"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "GABARITO: A — Tempo de convergir e risco em ambiente compartilhado"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "POR QUÊ (EXPLICAÇÃO DO JOGO)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Cada agente replica parte do contexto; cache reduz preço, mas não zera uso. Ação"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "sobre ambiente compartilhado soma risco que não está na fatura."
                }
              ]
            }
          ]
        }
