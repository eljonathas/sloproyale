      "index": "b0rzve",
      "props": {
        "geo": "rectangle",
        "dash": "solid",
        "url": "",
        "w": 1940,
        "h": 144,
        "growY": 0,
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "labelColor": "black",
        "color": "violet",
        "fill": "fill",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "07 · Autonomia e risco",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Preparação do apresentador · 4 perguntas · respostas extraídas do banco do jogo"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Leia de cima para baixo: ensine o conceito à esquerda e confira a cobrança à direita."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
    {
      "x": 0,
