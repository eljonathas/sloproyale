            },
            {
              "type": "paragraph",
              "content": []
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "POR QUÊ (EXPLICAÇÃO DO JOGO)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Em agosto de 2026 a OpenAI apresentou o Codex como plataforma e tratou o harness"
                }
